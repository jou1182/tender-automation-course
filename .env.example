# ══════════════════════════════════════════════════════════════
#  ملف الإعدادات النموذجي — انسخه إلى .env واملأ القيم
#  .env.example  ->  cp .env.example .env
#  القيم الحساسة يمكن تركها كنص عادي، أو تشفيرها عبر security_vault.
# ══════════════════════════════════════════════════════════════

# ── [مطلوب] تيليجرام ─────────────────────────────────────────
TELEGRAM_TOKEN=ضع_توكن_البوت_هنا          # من @BotFather
CHAT_ID=-100xxxxxxxxxx                     # معرّف مجموعة الإشعارات
# ADMIN_USER_ID=123456789                  # (اختياري) حصر التحكم بمستخدم واحد

# ── [مطلوب] لوحة الويب ───────────────────────────────────────
DASHBOARD_PASSWORD=غيّر_كلمة_مرور_اللوحة
ADMIN_PASSWORD=غيّر_كلمة_مرور_المشرف
DB_PATH=/opt/APP/output/tenders.db         # مسار قاعدة البيانات (من provision_instance.py)
DASHBOARD_PORT=5050
# DASHBOARD_SECRET=                         # (اختياري) يُولّد ويُحفظ تلقائياً إن تُرك فارغاً
# SESSION_IDLE_HOURS=2                      # انتهاء الجلسة بعد سكون (افتراضي ساعتان)
# ENGINEER_PIN=0000                         # رمز دخول بوابة المهندسين

# ── [مطلوب] الذكاء الاصطناعي ─────────────────────────────────
OPENAI_API_KEY=sk-...                       # دردشة GPT
# GEMINI_API_KEY=...                        # (اختياري) الردود الصوتية
# GOOGLE_TTS_KEY=...                        # (اختياري) صوت بديل

# ── [مطلوب] منصة المناقصات ───────────────────────────────────
PORTAL_URL=https://بوابة-الشركة.com
# PORTAL_USERNAME=                          # للسحب الذاتي (Selenium) فقط
# PORTAL_PASSWORD=
# MFA_WAIT_SECONDS=30
# CHECK_INTERVAL_MINUTES=5                  # تكرار فحص المنصة

# ── [مطلوب للنشر] السيرفر (سكريبتات الرفع/النشر) ─────────────
SERVER_IP=xxx.xxx.xxx.xxx
SERVER_USER=المستخدم
SERVER_PASS=كلمة_مرور_السيرفر
SERVER_PROJECT_PATH=/opt/APP
# SSH_KEY_PATH=                             # بديل عن كلمة المرور (مفتاح SSH)

# ── [اختياري] المراقبة ───────────────────────────────────────
# UPTIMEROBOT_HEARTBEAT_URL=
